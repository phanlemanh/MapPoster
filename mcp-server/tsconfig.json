{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  // scripts/ was excluded, so gen-example.ts silently drifted out of sync with
  // RenderDeps and only failed at runtime. Typecheck it like everything else.
  "include": ["src", "scripts", "config.ts"]
}
