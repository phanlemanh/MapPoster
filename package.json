{
  "name": "map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm install && vite build && playwright install chromium",
    "dev": "vite",
    "build": "tsc -b && tsc -p mcp-server/tsconfig.json && vitest run && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:mcp": "MCP_INTEGRATION=1 vitest run mcp-server/src/renderFrame.test.ts",
    "typecheck:mcp": "tsc -p mcp-server/tsconfig.json",
    "mcp:stdio": "tsx mcp-server/src/stdio.ts",
    "mcp:http": "tsx mcp-server/src/http.ts",
    "verify": "tsc -b && tsc -p mcp-server/tsconfig.json && vitest run && playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tmcw/togeojson": "^7.1.2",
    "jspdf": "^4.2.1",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
